{
  "$schema": "./node_modules/@biomejs/biome/configuration_schema.json",
  "extends": [
    "ultracite/biome/core",
    "ultracite/biome/next",
    "ultracite/biome/react",
    "ultracite/biome/vitest"
  ],
  "files": {
    "includes": [
      "!.claude/worktrees",
      // Historical records: the Markdown formatter would rewrite their code samples.
      "!docs/archive",
      "!src/components/ui",
      "!src/app/(payload)",
      "!src/payload-types.ts",
      "!src/app/(payload)/admin/importMap.js"
    ]
  },
  "assist": {
    "actions": {
      "source": {
        // Preserve intentional grouping when upgrading Ultracite's presets.
        "useSortedKeys": "off",
        "useSortedPackageJson": "off",
        "useSortedSelectionSet": "off",
        "useSortedTypeFields": "off"
      }
    }
  },
  "linter": {
    "rules": {
      "style": {
        // Keep the existing expression and callback style.
        "noIncrementDecrement": "off",
        "useConsistentArrowReturn": "off",
        "useDestructuring": "off",
        // Source files are kebab-case; Next.js and Payload reserved names
        // (page, layout, route, [slug], (group)) already comply.
        "useFilenamingConvention": {
          "level": "error",
          "options": { "filenameCases": ["kebab-case"], "requireAscii": true }
        }
      },
      "suspicious": {
        // Keep the "widely available" bar and exempt only the progressive
        // enhancements in use: older browsers ignore text-wrap, @property and
        // view transitions, and Safari's partial ::marker covers `color`.
        "useBaseline": {
          "level": "error",
          "options": {
            "allowAtRules": ["property"],
            "allowProperties": ["text-wrap"],
            "allowSelectors": ["marker", "view-transition"]
          }
        },
        // Existing nullish guards intentionally match both null and undefined.
        "noEqualsToNull": "off",
        "noBitwiseOperators": "off",
        "noUnknownAtRules": "off",
        // Biome cannot reliably track mutable React refs or validate stored CMS data.
        "noUnnecessaryConditions": "off",
        // This rule also flags boolean state and intentional string children as leaks.
        "noLeakedRender": "off"
      },
      "complexity": {
        "noUselessCatchBinding": "off",
        "noCommaOperator": "off"
      },
      "performance": {
        // Sequential CMS operations preserve order and avoid request bursts.
        "noAwaitInLoops": "off",
        // Callback allocation alone does not establish a React performance issue.
        "noJsxPropsBind": "off",
        "noBarrelFile": "off"
      }
    }
  },
  "overrides": [
    {
      // Route factories run once at module scope per page file; the
      // components they return are stable, not rebuilt on each render.
      "includes": [
        "src/utilities/create-entity-archive-page.tsx",
        "src/utilities/create-paginated-archive-page.tsx",
        "src/app/(frontend)/\\[lyovson\\]/_utilities/create-lyovson-feed-page.tsx"
      ],
      "linter": {
        "rules": { "correctness": { "noComponentHookFactories": "off" } }
      }
    },
    {
      // Rich text renders blocks and blocks render nested rich text; every
      // use is inside a render, so load order cannot leave a value undefined.
      "includes": [
        "src/blocks/*/component.tsx",
        "src/components/RichText/index.tsx",
        "src/components/RichText/serialize.tsx"
      ],
      "linter": {
        "rules": { "suspicious": { "noImportCycles": "off" } }
      }
    },
    {
      // Payload names generated migrations with timestamps and underscores.
      "includes": ["src/migrations/**"],
      "linter": {
        "rules": { "style": { "useFilenamingConvention": "off" } }
      }
    }
  ]
}
