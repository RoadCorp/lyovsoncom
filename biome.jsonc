{
  "$schema": "./node_modules/@biomejs/biome/configuration_schema.json",
  "extends": [
    "ultracite/biome/core",
    "ultracite/biome/next",
    "ultracite/biome/react",
    "ultracite/biome/vitest"
  ],
  "files": {
    "includes": [
      "!.claude/worktrees",
      "!src/components/ui",
      "!src/app/(payload)",
      "!src/payload-types.ts",
      "!src/app/(payload)/admin/importMap.js",
      "!!**/src/utilities/test-*.ts",
      "!!**/src/utilities/check-*.ts",
      "!!**/src/utilities/migrations/run-*.ts",
      "!!**/src/utilities/migrate-*.ts"
    ]
  },
  "assist": {
    "actions": {
      "source": {
        // Preserve intentional grouping when upgrading Ultracite's presets.
        "useSortedKeys": "off",
        "useSortedPackageJson": "off",
        "useSortedSelectionSet": "off",
        "useSortedTypeFields": "off"
      }
    }
  },
  "linter": {
    "rules": {
      "style": {
        // Keep the existing expression and callback style.
        "noIncrementDecrement": "off",
        "useConsistentArrowReturn": "off",
        "useDestructuring": "off",
        "useFilenamingConvention": "off"
      },
      "suspicious": {
        // Existing nullish guards intentionally match both null and undefined.
        "noEqualsToNull": "off",
        "noBitwiseOperators": "off",
        "noUnknownAtRules": "off",
        // Biome cannot reliably track mutable React refs or validate stored CMS data.
        "noUnnecessaryConditions": "off",
        // This rule also flags boolean state and intentional string children as leaks.
        "noLeakedRender": "off"
      },
      "complexity": {
        "noUselessCatchBinding": "off",
        "noCommaOperator": "off"
      },
      "performance": {
        // Sequential CMS operations preserve order and avoid request bursts.
        "noAwaitInLoops": "off",
        // Callback allocation alone does not establish a React performance issue.
        "noJsxPropsBind": "off",
        "noBarrelFile": "off"
      }
    }
  }
}
