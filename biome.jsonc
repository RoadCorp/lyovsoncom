{
  "$schema": "./node_modules/@biomejs/biome/configuration_schema.json",
  "extends": ["ultracite/biome/core", "ultracite/biome/next"],
  "files": {
    "includes": [
      "!.claude/worktrees",
      "!src/components/ui",
      "!src/app/(payload)",
      "!src/payload-types.ts",
      "!src/app/(payload)/admin/importMap.js",
      "!!**/src/utilities/test-*.ts",
      "!!**/src/utilities/check-*.ts",
      "!!**/src/utilities/migrations/run-*.ts",
      "!!**/src/utilities/migrate-*.ts"
    ]
  },
  "assist": {
    "actions": {
      "source": {
        // Preserve intentional grouping when upgrading Ultracite's presets.
        "useSortedKeys": "off",
        "useSortedPackageJson": "off",
        "useSortedSelectionSet": "off",
        "useSortedTypeFields": "off"
      }
    }
  },
  "linter": {
    "rules": {
      "style": {
        // Keep the existing expression and callback style.
        "noIncrementDecrement": "off",
        "useConsistentArrowReturn": "off",
        "useDestructuring": "off",
        "noMagicNumbers": "warn",
        "useFilenamingConvention": "off",
        "noNonNullAssertion": "warn",
        "noNestedTernary": "warn",
        "noNamespace": "warn",
        "useConsistentTypeDefinitions": "warn"
      },
      "suspicious": {
        // Existing nullish guards intentionally match both null and undefined.
        "noEqualsToNull": "off",
        "noExplicitAny": "warn",
        "noArrayIndexKey": "warn",
        "noBitwiseOperators": "off",
        "noEmptyBlockStatements": "warn",
        "noUnknownAtRules": "off",
        "useAwait": "warn",
        "noEvolvingTypes": "warn",
        "noImplicitAnyLet": "warn",
        "noDocumentCookie": "warn",
        "noShadow": "warn",
        "noUnnecessaryConditions": "warn"
      },
      "complexity": {
        "noUselessCatchBinding": "off",
        "noExcessiveCognitiveComplexity": "warn",
        "noCommaOperator": "off",
        "noForEach": "warn",
        "noBannedTypes": "warn"
      },
      "performance": {
        // Sequential CMS operations preserve order and avoid request bursts.
        "noAwaitInLoops": "off",
        // Callback allocation alone does not establish a React performance issue.
        "noJsxPropsBind": "off",
        "noBarrelFile": "off",
        "useTopLevelRegex": "warn",
        "noNamespaceImport": "warn"
      },
      "a11y": {
        "noSvgWithoutTitle": "warn",
        "useValidAnchor": "warn",
        "useButtonType": "warn",
        "useAriaPropsSupportedByRole": "warn",
        "useSemanticElements": "warn",
        "noNoninteractiveElementInteractions": "warn",
        "useKeyWithClickEvents": "warn",
        "noStaticElementInteractions": "warn",
        "useFocusableInteractive": "warn",
        "useAriaPropsForRole": "warn"
      },
      "security": {
        "noDangerouslySetInnerHtml": "warn"
      },
      "correctness": {
        "noUnusedVariables": "warn",
        "useExhaustiveDependencies": "warn",
        "noUnusedFunctionParameters": "warn",
        "noNestedComponentDefinitions": "warn"
      }
    }
  }
}
