{
  "name": "lyovsoncom",
  "version": "3.0.0",
  "description": "The official website of Rafa and Jess Lyóvson",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "build": "cross-env NODE_OPTIONS=--no-deprecation next build",
    "dev": "cross-env NODE_OPTIONS=--no-deprecation next dev",
    "dev:https": "cross-env NODE_OPTIONS=--no-deprecation next dev --experimental-https",
    "generate:importmap": "cross-env NODE_OPTIONS=--no-deprecation payload generate:importmap",
    "generate:types": "cross-env NODE_OPTIONS=--no-deprecation payload generate:types",
    "format": "ultracite fix",
    "lint": "ultracite check --error-on-warnings",
    "lint:fix": "ultracite fix",
    "payload": "cross-env NODE_OPTIONS=--no-deprecation payload",
    "seo:check": "node scripts/check-seo-coverage.mjs",
    "reinstall": "cross-env NODE_OPTIONS=--no-deprecation rm -rf node_modules && rm pnpm-lock.yaml && pnpm --ignore-workspace install",
    "start": "cross-env NODE_OPTIONS=--no-deprecation next start",
    "test": "vitest run",
    "test:browser": "playwright test",
    "preview:experience:build": "node scripts/public-experience-preview.mjs build",
    "preview:experience": "node scripts/public-experience-preview.mjs start"
  },
  "dependencies": {
    "@ai-sdk/openai": "^4.0.58",
    "@icons-pack/react-simple-icons": "^13.15.1",
    "@next/third-parties": "16.3.4",
    "@payloadcms/db-vercel-postgres": "3.88.0",
    "@payloadcms/email-resend": "3.88.0",
    "@payloadcms/next": "3.88.0",
    "@payloadcms/payload-cloud": "3.88.0",
    "@payloadcms/plugin-form-builder": "3.88.0",
    "@payloadcms/plugin-nested-docs": "3.88.0",
    "@payloadcms/plugin-redirects": "3.88.0",
    "@payloadcms/plugin-search": "3.88.0",
    "@payloadcms/plugin-seo": "3.88.0",
    "@payloadcms/richtext-lexical": "3.88.0",
    "@payloadcms/storage-vercel-blob": "3.88.0",
    "@payloadcms/ui": "3.88.0",
    "@vercel/analytics": "^2.0.1",
    "ai": "^7.0.92",
    "babel-plugin-react-compiler": "^1.0.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cross-env": "^10.1.0",
    "drizzle-kit": "^0.31.10",
    "drizzle-orm": "^0.45.2",
    "feed": "^6.0.0",
    "geist": "^1.7.2",
    "graphql": "^16.14.2",
    "jsonwebtoken": "^9.0.3",
    "lucide-react": "^1.41.0",
    "next": "16.3.4",
    "next-themes": "^0.4.6",
    "payload": "3.88.0",
    "prism-react-renderer": "^2.4.1",
    "radix-ui": "^1.6.7",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-tweet": "^3.3.1",
    "sharp": "^0.35.4",
    "tailwind-merge": "^3.6.0",
    "tailwindcss-animate": "^1.0.7",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.12",
    "@next/playwright": "16.3.4",
    "@playwright/test": "^1.63.0",
    "@tailwindcss/postcss": "^4.3.3",
    "@tailwindcss/typography": "^0.5.20",
    "@types/escape-html": "^1.0.4",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "copyfiles": "^2.4.1",
    "dotenv": "^17.4.2",
    "esbuild": "^0.28.2",
    "postcss": "^8.5.28",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "ultracite": "7.10.8",
    "vite": "^8.2.2",
    "vitest": "^5.0.0"
  },
  "engines": {
    "node": "^24"
  },
  "packageManager": "pnpm@10.30.0",
  "browserslist": [
    "chrome >= 87",
    "edge >= 88",
    "firefox >= 78",
    "safari >= 14"
  ]
}
